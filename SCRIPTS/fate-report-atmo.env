# General parameters for Elena's programs
GG='5GG'
HH='1H'
STARTMINUTE=300            # from 19:00 LT
ENDMINUTE=960              # to 06:00 LT

# Directories
DATA_ROOT_DIR=$HOME'/DATA/TREATED/'$FCST_DAY_SHORT$FCST_LEN
DATA_PERS_DIR=$HOME"/DATA/TREATED/"$FCST_DAY_SHORT"_PERSIST"
FIGS_ROOT_DIR=$HOME"/FIGS"
PROG_ROOT_DIR=$HOME"/PROG/AR_${GG}_${HH}"
PERS_ROOT_DIR=$HOME"/PROG/PERSISTENCE"
LIBPERSO_DIR=$HOME"/bin/LIBPERSO"
NUMREC_DIR=$HOME"/bin/NUMREC"
SCRDIR=$HOME'/SCRIPTS'
LOGOSDIR=$SCRDIR'/LOGOS'
WRKDIR=$HOME'/WRKDIR'
REPORTDIR=$HOME'/REPORT'
funcfile=$HOME'/SCRIPTS/functions.sh'

# Misc
skills_file="skills"
skills_file_lastmonth="LastMonth"
export LC_TIME="en_US.UTF-8"

# General settings for the Latex templates
header_tmpl_file=$SCRDIR'/TMPL_LATEX/header_tmpl.tex'
main_tmpl_file=$SCRDIR'/TMPL_LATEX/FATE_report_template.tex'
annex_tmpl_file=$SCRDIR'/TMPL_LATEX/FATE_annex_template.tex'
tail_tmpl_file=$SCRDIR'/TMPL_LATEX/tail_tmpl.tex'
clearpage_file=$SCRDIR'/TMPL_LATEX/clearpage.tex'
textLOGs_file=$SCRDIR'/TMPL_LATEX/textLOGs.tex'
STARTOFSERVICE_YYYY='2023'
STARTOFSERVICE_MM='09'
STARTOFSERVICE_DD='01'
STARTOFSERVICE=`date +"%d-%m-%Y" --date "$STARTOFSERVICE_YYYY-$STARTOFSERVICE_MM-$STARTOFSERVICE_DD"`
STARTOFSERVICE_STR2=`date +"%Y%m%d" --date "$STARTOFSERVICE_YYYY-$STARTOFSERVICE_MM-$STARTOFSERVICE_DD"`
STARTOFSERVICE_STR3=`date +"%Y-%m-%d" --date "$STARTOFSERVICE_YYYY-$STARTOFSERVICE_MM-$STARTOFSERVICE_DD"`
TODAYSTRING=`date +"%Y-%m-%d" --date "today"`
TODAYDATESTRING=`date +"%d-%m-%Y" --date "today"`
TODAYMONTHSTRING=`date +"%B" --date "today"`
LASTMONTHSTRING=`date +"%B" --date "last month"`
LASTMONTHDIGIT=`date +"%m" --date "last month"`
LASTYEARSTRING=`date +"%Y" --date "last month"`
TODAYYEARSTRING=`date +"%Y" --date "today"`
TODAYDOWSTRING=`date +"%a" --date "today"`
TODAYDOWSTRINGL=`date +"%A" --date "today"`
TODAYTIMESTRING=`date +"%H%M" --date "today"`
TODAYSTRING_CHILE=`TZ='America/Santiago'     date +"%d-%m-%Y" --date "now"`
TODAYDOWSTRING_CHILE=`TZ='America/Santiago'  date +"%a"       --date "now"`
TODAYDOWSTRINGL_CHILE=`TZ='America/Santiago' date +"%A"       --date "now"`
TODAYTIMESTRING_CHILE=`TZ='America/Santiago' date +"%H:%M"    --date "now"`
file_legend1=$SCRDIR'/TMPL_LATEX/legend1.tex'
file_legend2=$SCRDIR'/TMPL_LATEX/legend2.tex'
file_legend3=$SCRDIR'/TMPL_LATEX/legend3.tex'
report_tex_file=$REPORTDIR/FATE-REPORT_${TODAYSTRING}.tex
report_pdf_file=$REPORTDIR/`basename $report_tex_file .tex`.pdf
annex_tex_file=$REPORTDIR/FATE-ANNEX_${TODAYSTRING}.tex
annex_pdf_file=$REPORTDIR/`basename $annex_tex_file .tex`.pdf
fate_sty=$SCRDIR'/TMPL_LATEX/fate.sty'

# Log analysis
LOGDIR='/DATAPRE/data/MESONH_inp/LOG'
LOGDIR_MNH_NIGHT='/TERASTARMET/FATE_BACKUPS_mesohp1/runcontrol'
LOGDIR_MNH_DAY='/TERASTARMET/FATE_BACKUPS_mesohp2/runcontrol'
NODATA_STR='NA'

